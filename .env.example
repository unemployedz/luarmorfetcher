# Copy to .env (gitignored) and fill in. Never commit real values.

# The Discord bot token from the developer portal (Bot -> Token).
DISCORD_TOKEN=

# Command prefix. "." gives ".fetch".
LRM_PREFIX=.

# Seconds a bare ".fetch" waits for the pasted link.
LRM_PENDING_TTL=180

# --- CLI only (the Discord bot does not use these) -------------------------

# Path to the Deobfuscator-Luraph-V15 sandbox repo (luau + envlog harness).
LUARMOR_REPO=
# Override the luau binary if the bundled one cannot run on your CPU.
LUARMOR_LUAU=
# Your Luarmor script key, for the fetch / two-phase pipelines.
LRM_SCRIPT_KEY=
